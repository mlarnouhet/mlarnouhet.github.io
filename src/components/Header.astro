---
import { site } from "../../site.config.mjs";
interface Props {
  section?: "about" | "blog";
}
const { section } = Astro.props;
---

<header class="site-header frame">
  <a class="wordmark" href="/"
    >{site.author || site.title}<span aria-hidden="true"></span></a
  >
  <nav aria-label="Main navigation">
    <a href="/" aria-current={section === "about" ? "page" : undefined}>About</a
    >
    <a href="/blog/" aria-current={section === "blog" ? "page" : undefined}
      >Blog</a
    >
  </nav>
</header>
