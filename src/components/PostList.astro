---
import type { CollectionEntry } from 'astro:content';
import { formatDate, href } from '../lib/posts';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map(post => (
    <li>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div>
        <h3><a href={href(`blog/${post.id}/`)}>{post.data.title}<span aria-hidden="true"> ↗</span></a></h3>
        <p>{post.data.description}</p>
        <ul class="tags" aria-label="Topics">
          {post.data.tags.map(tag => <li>{tag}</li>)}
        </ul>
      </div>
    </li>
  ))}
</ol>
