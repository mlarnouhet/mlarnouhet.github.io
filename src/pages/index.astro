---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { site } from "../../site.config.mjs";
const posts = await getPosts();
const links = site.links as { label: string; url: string; newTab?: boolean }[];
---

<BaseLayout title="About" section="about">
  <section class="intro" aria-labelledby="about-title">
    <img
      class="profile-photo"
      src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${site.profileImage.src}`}
      alt={site.profileImage.alt}
      width="160"
      height="160"
      decoding="async"
    />
    <div class="intro-content">
      <h1 id="about-title">{site.headline}</h1>
      <div class="intro-copy">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {
        links.length > 0 && (
          <ul class="profile-links">
            {links.map((link) => (
              <li>
                <a
                  href={link.url.startsWith("/")
                    ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${link.url}`
                    : link.url}
                  target={link.newTab ? "_blank" : undefined}
                  rel={link.newTab ? "noopener noreferrer" : undefined}
                  aria-label={link.newTab ? `${link.label} (opens in a new tab)` : undefined}
                >
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Recent writing</h2>
      <a href="/blog/">All posts <span aria-hidden="true">↗</span></a>
    </div>
    <PostList posts={posts.slice(0, 3)} />
  </section>
</BaseLayout>
